    {
      "parameters": {
        "jsCode": "const pedidos = $input.all();\nconst hoy = new Date().toLocaleDateString('es-CO');\n\nconst pedidosHoy = pedidos.filter(p => p.json.fecha === hoy);\n\nif (pedidosHoy.length === 0) {\n  return [{ json: { reporte: '📊 No hubo pedidos hoy.' } }];\n}\n\nconst total = pedidosHoy.reduce((sum, p) => sum + Number(p.json.total_pago || 0), 0);\n\nconst productos = {};\npedidosHoy.forEach(p => {\n  const detalle = p.json.detalles_pedido || '';\n  if (!productos[detalle]) productos[detalle] = 0;\n  productos[detalle]++;\n});\n\nconst estrella = Object.entries(productos).sort((a,b) => b[1]-a[1])[0];\n\nconst reporte = `📊 REPORTE DIARIO DELIVERYBOT\n📅 Fecha: ${hoy}\n🛒 Pedidos: ${pedidosHoy.length}\n💰 Total vendido: $${total.toLocaleString()}\n⭐ Producto estrella: ${estrella ? estrella[0] : 'N/A'}`;\n\nreturn [{ json: { reporte } }];"
      },
